# ==============================================================================
# SpendWise - Environment Configuration Template
# Duplicate this file to .env and fill in the values for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database Configuration
# Find these in your Supabase Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Client / anon publishable key:
SUPABASE_KEY=sb_publishable_...
# Service Role key (Admin access, bypasses RLS for Telegram worker & background jobs):
SUPABASE_SERVICE_KEY=sb_secret_...

# ------------------------------------------------------------------------------
# 2. Google OAuth 2.0 Credentials
# Create these at: https://console.cloud.google.com/apis/credentials
# In production, add your domain callback to "Authorized redirect URIs":
# Example: https://spendwise.yourdomain.com/auth/google/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# For local development: http://127.0.0.1:8000/auth/google/callback
# For production: https://your-production-domain.com/auth/google/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# ------------------------------------------------------------------------------
# 3. Session Security
# Generate a strong 32-byte secret: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
SESSION_SECRET=your-random-32-byte-hex-string-for-session-encryption
# Set to 'true' in production with HTTPS to enforce Secure cookies; 'false' for local HTTP
COOKIE_HTTPS_ONLY=false

# ------------------------------------------------------------------------------
# 4. Telegram Bot (Webhook & Polling)
# Create a bot via @BotFather on Telegram (https://t.me/BotFather)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Optional: the username of your bot (without @) shown to users in the web UI
TELEGRAM_BOT_USERNAME=SpendWiseExpenseBot
# Webhook Secret Token for X-Telegram-Bot-Api-Secret-Token validation:
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret-token

# Deployed HTTPS Base URL (e.g. https://spendwise.onrender.com)
# NOTE: Render automatically provides RENDER_EXTERNAL_URL in production!
WEBHOOK_URL=https://your-production-domain.com/api/telegram/webhook

# Set to 'false' ONLY if behind a corporate proxy requiring self-signed SSL certs; default is 'true'
TELEGRAM_SSL_VERIFY=true

# ------------------------------------------------------------------------------
# 5. Gemini AI Parser
# Get an API key from Google AI Studio: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-flash-lite-latest

